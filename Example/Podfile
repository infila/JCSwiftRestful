use_frameworks!

platform :ios, '15.0'

# Keep the three repositories in the same parent directory for local development.
target 'JCSwiftRestful_Example' do
  pod 'JCSwiftRestful', :path => '../'
  pod 'JCSwiftCommon', :path => '../../JCSwiftCommon'
  pod 'JCSwiftUIWidgets', :path => '../../JCSwiftUIWidgets'

  target 'JCSwiftRestful_Tests' do
    inherit! :search_paths
  end
end

# Build local pods for the demo's deployment target while preserving each
# library's minimum supported iOS version in its own podspec.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      minimum = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if minimum && Gem::Version.new(minimum) < Gem::Version.new('15.0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
